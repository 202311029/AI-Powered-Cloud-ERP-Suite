// Amdox ERP — Complete Prisma Schema
// Single PostgreSQL 17 + TimescaleDB instance
// All tables: uuid PK, tenantId FK, createdAt, updatedAt, deletedAt (soft-delete)

datasource db {
  provider = "postgresql"

}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// MULTI-TENANCY
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String    @id @default(uuid())
  name      String
  domain    String?   @unique
  plan      String    @default("starter") // starter, pro, enterprise
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users               TenantUser[]
  roles               Role[]
  accounts            Account[]
  financialPeriods    FinancialPeriod[]
  journalEntries      JournalEntry[]
  invoices            Invoice[]
  payments            Payment[]
  fxRates             FxRate[]
  employees           Employee[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  attendanceLogs      AttendanceLog[]
  payrollRuns         PayrollRun[]
  payslips            Payslip[]
  vendors             Vendor[]
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]
  warehouses          Warehouse[]
  inventoryItems      InventoryItem[]
  demandForecasts     DemandForecast[]
  projects            Project[]
  milestones          Milestone[]
  tasks               Task[]
  resourceAssignments ResourceAssignment[]
  budgets             Budget[]
  dashboards          Dashboard[]
  scheduledReports    ScheduledReport[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  notifPreferences    NotificationPreference[]
  webhooks            Webhook[]
  webhookDeliveries   WebhookDelivery[]
  refreshTokens       RefreshToken[]
  timesheets          Timesheet[]

  @@index([domain])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  isActive     Boolean   @default(true)
  mfaSecret    String? // TOTP secret (encrypted at rest)
  mfaEnabled   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenants             TenantUser[]
  refreshTokens       RefreshToken[]
  notifications       Notification[]
  notifPreferences    NotificationPreference[]
  assignedTasks       Task[]                   @relation("TaskAssignee")
  resourceAssignments ResourceAssignment[]
  auditLogs           AuditLog[]               @relation("AuditLogUser")

  @@index([email])
}

model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model Role {
  id        String   @id @default(uuid())
  name      String // SuperAdmin, TenantAdmin, Manager, Employee, Viewer, APIClient
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  permissions Permission[]
  tenantUsers TenantUser[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id       String @id @default(uuid())
  roleId   String
  action   String // e.g. "finance:read", "hr:write", "payroll:run"
  resource String // e.g. "invoice", "employee", "payroll"

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, action, resource])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  tenantId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([token])
  @@index([userId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCE — General Ledger (F-02)
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id          String      @id @default(uuid())
  code        String // e.g. "1000", "2100"
  name        String
  type        AccountType
  parentId    String?
  description String?
  isActive    Boolean     @default(true)
  tenantId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  parent       Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountHierarchy")
  journalLines JournalLine[]
  budgets      Budget[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

model JournalEntry {
  id             String             @id @default(uuid())
  reference      String? // e.g. "JE-2026-001"
  description    String?
  date           DateTime           @default(now())
  currency       String             @default("INR")
  exchangeRate   Float              @default(1.0)
  status         JournalEntryStatus @default(Draft)
  periodId       String?
  isIntercompany Boolean            @default(false)
  tenantId       String
  createdBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  period FinancialPeriod? @relation(fields: [periodId], references: [id])
  lines  JournalLine[]

  @@index([tenantId])
  @@index([date])
  @@index([status])
}

enum JournalEntryStatus {
  Draft
  Posted
  Void
}

model JournalLine {
  id             String   @id @default(uuid())
  journalEntryId String
  accountId      String
  type           LineType // Debit or Credit
  amount         Float
  description    String?
  tenantId       String

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

enum LineType {
  Debit
  Credit
}

model FinancialPeriod {
  id        String    @id @default(uuid())
  name      String // e.g. "April 2026"
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean   @default(false)
  closedAt  DateTime?
  closedBy  String?
  tenantId  String
  createdAt DateTime  @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  journalEntries JournalEntry[]

  @@index([tenantId])
}

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique // "USD", "INR", "EUR"
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  fxRates   FxRate[] @relation("BaseCurrency")
  fxRatesTo FxRate[] @relation("QuoteCurrency")
}

model FxRate {
  id            String   @id @default(uuid())
  baseCurrency  String // "USD"
  quoteCurrency String // "INR"
  rate          Float
  date          DateTime @default(now())
  source        String   @default("frankfurter.app")
  tenantId      String

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  base   Currency @relation("BaseCurrency", fields: [baseCurrency], references: [code])
  quote  Currency @relation("QuoteCurrency", fields: [quoteCurrency], references: [code])

  @@index([tenantId, date])
  @@index([baseCurrency, quoteCurrency, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCE — AP/AR (F-03)
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String?
  type            InvoiceType // AP (payable) or AR (receivable)
  status          InvoiceStatus @default(Draft)
  vendorId        String?
  vendorName      String? // fallback if no vendor master
  customerName    String? // for AR
  lineItems       Json? // extracted line items (OCR output)
  subtotal        Float         @default(0)
  taxAmount       Float         @default(0)
  totalAmount     Float
  currency        String        @default("INR")
  dueDate         DateTime
  ocrConfidence   Float?
  purchaseOrderId String?
  goodsReceiptId  String?
  periodId        String?
  tenantId        String
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id])
  payments      Payment[]

  @@index([tenantId])
  @@index([type, status])
  @@index([dueDate])
}

enum InvoiceType {
  AP
  AR
}

enum InvoiceStatus {
  Draft
  Pending
  Approved
  Rejected
  Paid
  PartiallyPaid
  Overdue
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  amount    Float
  currency  String   @default("INR")
  method    String? // Bank Transfer, Cheque, UPI
  reference String?
  date      DateTime @default(now())
  tenantId  String
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// HR & PAYROLL (F-04)
// ─────────────────────────────────────────────────────────────────────────────

model Employee {
  id             String    @id @default(uuid())
  employeeCode   String?
  firstName      String
  lastName       String
  email          String
  phone          String?
  department     String?
  designation    String?
  managerId      String?
  hireDate       DateTime?
  exitDate       DateTime?
  employmentType String    @default("Full_Time") // Full_Time, Part_Time, Contract
  baseSalary     Float?
  bankAccount    String?
  panNumber      String? // Indian tax ID
  pfNumber       String?
  esiNumber      String?
  isActive       Boolean   @default(true)
  tenantId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  manager             Employee?            @relation("OrgHierarchy", fields: [managerId], references: [id])
  directReports       Employee[]           @relation("OrgHierarchy")
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  attendanceLogs      AttendanceLog[]
  payslips            Payslip[]
  resourceAssignments ResourceAssignment[]
  timesheets          Timesheet[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([managerId])
  @@index([department])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  leaveType  String // Annual, Sick, Casual, Maternity, Paternity, Unpaid
  startDate  DateTime
  endDate    DateTime
  days       Float
  reason     String?
  status     LeaveStatus @default(Pending)
  approvedBy String?
  approvedAt DateTime?
  tenantId   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId, status])
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

model LeaveBalance {
  id         String   @id @default(uuid())
  employeeId String
  leaveType  String
  year       Int
  entitled   Float
  used       Float    @default(0)
  balance    Float
  tenantId   String
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, leaveType, year])
  @@index([tenantId, employeeId])
}

model AttendanceLog {
  id          String    @id @default(uuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  overtime    Float?    @default(0)
  status      String    @default("Present") // Present, Absent, HalfDay, Holiday
  tenantId    String
  createdAt   DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
}

model PayrollRun {
  id              String        @id @default(uuid())
  period          String // e.g. "June 2026"
  periodStart     DateTime
  periodEnd       DateTime
  status          PayrollStatus @default(Pending)
  totalGross      Float         @default(0)
  totalDeductions Float         @default(0)
  totalNet        Float         @default(0)
  employeeCount   Int           @default(0)
  runBy           String?
  completedAt     DateTime?
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payslips Payslip[]

  @@index([tenantId])
  @@index([status])
}

enum PayrollStatus {
  Pending
  Processing
  Completed
  Failed
  Cancelled
}

model Payslip {
  id               String   @id @default(uuid())
  payrollRunId     String
  employeeId       String
  period           String
  basicPay         Float
  hra              Float    @default(0)
  specialAllowance Float    @default(0)
  grossPay         Float
  pfEmployee       Float    @default(0) // 12% of basic
  pfEmployer       Float    @default(0)
  esiEmployee      Float    @default(0)
  esiEmployer      Float    @default(0)
  professionalTax  Float    @default(0)
  tds              Float    @default(0) // Income tax deducted at source
  lwf              Float    @default(0) // Labour welfare fund
  totalDeductions  Float
  netPay           Float
  pdfUrl           String?
  tenantId         String
  createdAt        DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([payrollRunId])
  @@index([employeeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPLY CHAIN & INVENTORY (F-05)
// ─────────────────────────────────────────────────────────────────────────────

model Vendor {
  id           String    @id @default(uuid())
  code         String?
  name         String
  email        String?
  phone        String?
  address      String?
  gstNumber    String?
  paymentTerms String? // e.g. "Net30"
  rating       Float? // 0-5
  isActive     Boolean   @default(true)
  tenantId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]

  @@index([tenantId])
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  poNumber     String?
  vendorId     String?
  vendorName   String? // fallback
  status       POStatus  @default(Draft)
  currency     String    @default("INR")
  subtotal     Float     @default(0)
  taxAmount    Float     @default(0)
  totalAmount  Float     @default(0)
  expectedDate DateTime?
  deliveredAt  DateTime?
  notes        String?
  tenantId     String
  createdBy    String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  vendor        Vendor?             @relation(fields: [vendorId], references: [id])
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  invoices      Invoice[]

  @@index([tenantId])
  @@index([status])
}

enum POStatus {
  Draft
  Submitted
  Approved
  Ordered
  PartiallyReceived
  Received
  Cancelled
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  purchaseOrderId String
  inventoryItemId String?
  description     String
  sku             String?
  quantity        Float
  unitPrice       Float
  totalPrice      Float
  receivedQty     Float   @default(0)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  grNumber        String?
  purchaseOrderId String
  receivedBy      String?
  notes           String?
  dateReceived    DateTime @default(now())
  tenantId        String

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  invoices      Invoice[]
  lines         GoodsReceiptLine[]

  @@index([tenantId])
  @@index([purchaseOrderId])
}

model GoodsReceiptLine {
  id              String  @id @default(uuid())
  goodsReceiptId  String
  inventoryItemId String?
  sku             String?
  description     String
  orderedQty      Float
  receivedQty     Float
  warehouseId     String?

  goodsReceipt  GoodsReceipt   @relation(fields: [goodsReceiptId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id])

  @@index([goodsReceiptId])
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String
  name      String
  location  String?
  isActive  Boolean  @default(true)
  tenantId  String
  createdAt DateTime @default(now())

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  stockLevels StockLevel[]
  grLines     GoodsReceiptLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model InventoryItem {
  id            String    @id @default(uuid())
  sku           String
  name          String
  description   String?
  category      String?
  unitOfMeasure String    @default("pcs")
  costPrice     Float     @default(0) // FIFO cost
  sellingPrice  Float     @default(0)
  reorderLevel  Int       @default(10)
  reorderQty    Int       @default(50)
  isActive      Boolean   @default(true)
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  stockLevels StockLevel[]
  forecasts   DemandForecast[]
  poLines     PurchaseOrderLine[]
  grLines     GoodsReceiptLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model StockLevel {
  id              String   @id @default(uuid())
  inventoryItemId String
  warehouseId     String
  quantity        Float    @default(0)
  reservedQty     Float    @default(0)
  updatedAt       DateTime @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])

  @@unique([inventoryItemId, warehouseId])
  @@index([inventoryItemId])
}

model DemandForecast {
  id              String   @id @default(uuid())
  inventoryItemId String
  forecastDate    DateTime
  predictedDemand Float
  safetyStock     Float
  mapeEstimate    Float?
  modelUsed       String   @default("prophet") // prophet, lstm, ensemble
  confidence      Float?
  tenantId        String
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId, inventoryItemId])
  @@index([forecastDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// PROJECT MANAGEMENT (F-07)
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(uuid())
  code        String?
  name        String
  description String?
  status      ProjectStatus @default(Planning)
  startDate   DateTime?
  endDate     DateTime?
  managerId   String?
  tenantId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  milestones  Milestone[]
  tasks       Task[]
  assignments ResourceAssignment[]
  budgets     Budget[]
  timesheets  Timesheet[]

  @@index([tenantId])
  @@index([status])
}

enum ProjectStatus {
  Planning
  Active
  OnHold
  Completed
  Cancelled
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime
  status      MilestoneStatus @default(Pending)
  tenantId    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  tasks   Task[]

  @@index([projectId])
  @@index([tenantId])
}

enum MilestoneStatus {
  Pending
  InProgress
  Completed
  Overdue
}

model Task {
  id             String     @id @default(uuid())
  projectId      String
  milestoneId    String?
  parentTaskId   String? // for sub-tasks / DAG
  name           String
  description    String?
  status         TaskStatus @default(Todo)
  priority       String     @default("Medium") // Low, Medium, High, Critical
  assigneeId     String?
  startDate      DateTime?
  endDate        DateTime?
  estimatedHours Float?
  actualHours    Float?
  tenantId       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  project    Project     @relation(fields: [projectId], references: [id])
  milestone  Milestone?  @relation(fields: [milestoneId], references: [id])
  parent     Task?       @relation("TaskDependency", fields: [parentTaskId], references: [id])
  subtasks   Task[]      @relation("TaskDependency")
  assignee   User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  timesheets Timesheet[]

  @@index([projectId])
  @@index([tenantId])
  @@index([assigneeId])
}

enum TaskStatus {
  Todo
  InProgress
  InReview
  Done
  Blocked
  Cancelled
}

model ResourceAssignment {
  id            String    @id @default(uuid())
  projectId     String
  employeeId    String
  userId        String?
  role          String? // "Developer", "Designer", etc.
  allocationPct Float     @default(100) // % of time allocated
  startDate     DateTime
  endDate       DateTime?
  tenantId      String
  createdAt     DateTime  @default(now())

  project  Project  @relation(fields: [projectId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([projectId])
  @@index([tenantId])
}

model Budget {
  id        String   @id @default(uuid())
  projectId String?
  accountId String?
  name      String
  amount    Float
  spent     Float    @default(0)
  period    String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  tenant  Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([projectId])
}

model Timesheet {
  id          String   @id @default(uuid())
  projectId   String
  taskId      String?
  employeeId  String
  date        DateTime
  hours       Float
  description String?
  isLocked    Boolean  @default(false)
  tenantId    String
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])
  task     Task?    @relation(fields: [taskId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([projectId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// BUSINESS INTELLIGENCE (F-08)
// ─────────────────────────────────────────────────────────────────────────────

model Dashboard {
  id          String    @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean   @default(false)
  layout      Json? // widget positions
  tenantId    String
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  widgets Widget[]

  @@index([tenantId])
}

model Widget {
  id          String   @id @default(uuid())
  dashboardId String
  type        String // kpi, bar, line, pie, heatmap, funnel, table
  title       String
  config      Json // query config, filters, etc.
  position    Json // {x, y, w, h}
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dashboard Dashboard @relation(fields: [dashboardId], references: [id])

  @@index([dashboardId])
}

model ScheduledReport {
  id          String    @id @default(uuid())
  name        String
  description String?
  type        String // pdf, excel
  schedule    String // cron expression
  recipients  String[] // email list
  config      Json? // filter/date range config
  lastRunAt   DateTime?
  isActive    Boolean   @default(true)
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT & COMPLIANCE (F-09)
// Stored in TimescaleDB hypertable — append-only, hash-chained
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  action       String // CREATED, UPDATED, DELETED, LOGIN, LOGOUT, etc.
  entity       String // "Invoice", "Employee", "PayrollRun"
  entityId     String
  userId       String?
  ipAddress    String?
  userAgent    String?
  changes      Json? // before/after diff
  previousHash String?
  hash         String? // SHA-256 of (action+entity+entityId+userId+changes+previousHash)
  tenantId     String
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS (F-10)
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(uuid())
  userId    String
  tenantId  String
  title     String
  message   String
  type      NotificationType    @default(Info)
  channel   NotificationChannel @default(InApp)
  isRead    Boolean             @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime            @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, isRead])
  @@index([tenantId])
}

enum NotificationType {
  Info
  Success
  Warning
  Error
}

enum NotificationChannel {
  InApp
  Email
  Webhook
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String
  tenantId        String
  emailEnabled    Boolean  @default(true)
  inAppEnabled    Boolean  @default(true)
  webhookEnabled  Boolean  @default(false)
  quietHoursStart Int? // hour of day (0-23)
  quietHoursEnd   Int?
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model Webhook {
  id          String   @id @default(uuid())
  url         String
  events      String[] // ["INVOICE_CREATED", "PAYROLL_COMPLETED", ...]
  secret      String // HMAC-SHA256 signing secret
  description String?
  isActive    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  deliveries WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?
  attempt      Int      @default(1)
  success      Boolean  @default(false)
  sentAt       DateTime @default(now())
  tenantId     String

  webhook Webhook @relation(fields: [webhookId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([webhookId])
  @@index([tenantId, event])
}
